---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Silmun" description="That page does not exist." noindex>
  <section class="sec support-sec" style="border-top: 0">
    <div class="wrap stack g16">
      <span class="mod-label">404</span>
      <h1 class="display display-sm">That page is <span class="hlw">missing.</span></h1>
      <p class="lede">The link may be old. Try the home page, or pick an agent from Modules.</p>
      <div class="actions"><a class="btn btn-primary" href="/">Go to the home page <span class="k" aria-hidden="true">→</span></a></div>
    </div>
  </section>
</Base>
