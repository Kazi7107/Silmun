---
import '../styles/01-base.css';
import '../styles/02-components.css';
import '../styles/03-pages.css';
import '../styles/04-accent.css';
import '../styles/05-editorial.css';
import '../styles/06-site.css';
import '../styles/07-responsive.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SubNav from '../components/SubNav.astro';
import StoreButton from '../components/StoreButton.astro';
import { SITE, type AgentKey } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Which agent the nav and mobile "Get it on the Store" buttons point at. */
  storeAgent?: AgentKey;
  subnav?: { label: string; links: { href: string; text: string }[] };
  /** Sticky Store bar at the bottom on small screens. */
  mobileCta?: boolean;
  noindex?: boolean;
}

const { title, description, storeAgent = 'catalog', subnav, mobileCta = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL('/og.png', Astro.site ?? SITE.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F3F6F6" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Silmun" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wdth,wght@75..100,400..700&family=JetBrains+Mono:wght@400;500;600&display=swap" />

    <script is:inline>document.documentElement.classList.add('js');</script>
    {SITE.plausibleDomain && <script is:inline defer data-domain={SITE.plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="site">
      <Header storeAgent={storeAgent} />
      {subnav && <SubNav label={subnav.label} links={subnav.links} />}
      <main id="main">
        <slot />
      </main>
      <Footer />
      {mobileCta && <div class="m-sticky"><StoreButton agent={storeAgent} /></div>}
    </div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
