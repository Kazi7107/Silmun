---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { ROUTES } from '../data/site';
---
<Base
  title="About Silmun · ServiceNow agents"
  description="Silmun is an IT company and ServiceNow Build Partner. We build AI agents that work inside ServiceNow and publish them on the ServiceNow Store."
>
  <section class="hero hero-tight">
    <div class="wrap hero-top hero-top-last">
      <div class="hero-copy"><span class="mod-label">About us</span><h1 class="display">We build agents that work <span class="hlw">inside</span> ServiceNow.</h1></div>
      <p class="lede">We're an IT company and ServiceNow Build Partner. Some of our agents are already published on the ServiceNow Store, and the library keeps growing.</p>
    </div>
  </section>

  <section class="sec" id="kinds">
    <div class="wrap">
      <div class="intro">
        <div class="stack g12"><SectionHead no="01" label="Two kinds of agents" /><h2 class="h2">With or without an AI Agent Studio license.</h2></div>
        <p class="line1">Each agent page says which kind it is, so you know before you buy.</p>
      </div>
      <div class="kinds">
        <div class="kind">
          <span class="label">Kind A</span>
          <h3 class="h3">For teams with an AI Agent Studio license</h3>
          <p class="line1 line1-sm">Runs on ServiceNow's own AI, under the Now Assist license you already pay for.</p>
          <div class="objs kind-ex"><a class="obj" href={ROUTES.secops}>Example: Security Operations agent</a></div>
        </div>
        <div class="kind b">
          <span class="label kind-b-label">Kind B</span>
          <h3 class="h3">For teams without one</h3>
          <p class="line1 line1-sm">Runs on your own AI key, so you don't need Now Assist or AI Agent Studio at all.</p>
          <div class="objs kind-ex"><a class="obj" href={ROUTES.catalog}>Example: Catalog Automation</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec band" id="library">
    <div class="wrap">
      <div class="intro">
        <div class="stack g12"><SectionHead no="02" label="Our library" /><h2 class="h2">One module at a time.</h2></div>
        <p class="line1">We pick slow, repetitive ServiceNow work and build an agent for it.</p>
      </div>
      <div class="lib">
        <a class="lib-row" href={ROUTES.catalog}><span class="h3">ITSM</span><span class="small">Catalog Automation · without a license</span><span class="tag tag-live"><span class="dot"></span>Published</span></a>
        <a class="lib-row" href={ROUTES.secops}><span class="h3">Security Operations</span><span class="small">Vulnerability Remediation · with a license</span><span class="tag tag-live"><span class="dot"></span>Published</span></a>
        <a class="lib-row" href={ROUTES.sourceToPay}><span class="h3 dim">Source to Pay</span><span class="small">Finance &amp; Supply Chain</span><span class="tag tag-later"><span class="dot"></span>Next</span></a>
      </div>
    </div>
  </section>

  <section class="sec dark" id="how-we-build">
    <div class="wrap">
      <div class="intro">
        <div class="stack g12"><SectionHead no="03" label="How we build" /><h2 class="h2">Agents your security team can sign off on.</h2></div>
        <p class="line1">The same three rules hold for every agent we ship.</p>
      </div>
      <div class="reasons">
        <div class="reason"><span class="n">01</span><h3 class="h4">People approve what matters</h3><p class="line1 line1-sm">Agents propose. A person confirms anything that changes ownership, risk or your catalog.</p></div>
        <div class="reason"><span class="n">02</span><h3 class="h4">Everything is logged</h3><p class="line1 line1-sm">Every action lands on the record it touched, with the reason behind it.</p></div>
        <div class="reason"><span class="n">03</span><h3 class="h4">Standard ServiceNow, from the Store</h3><p class="line1 line1-sm">Installed as Store apps, run under your roles, and reviewed by ServiceNow before listing.</p></div>
      </div>
    </div>
  </section>

  <section class="sec sec-cta">
    <div class="wrap cta-row">
      <h2 class="h2 h2-sm">Have a ServiceNow job that eats your week?</h2>
      <a class="btn btn-primary" href={ROUTES.contact}>Tell us about it <span class="k" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
