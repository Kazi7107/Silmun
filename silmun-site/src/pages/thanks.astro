---
// Fallback for form posts when JavaScript is off. Netlify redirects here.
import Base from '../layouts/Base.astro';
---
<Base title="Thanks · Silmun" description="Your message was sent." noindex>
  <section class="sec support-sec" style="border-top: 0">
    <div class="wrap stack g16">
      <span class="mod-label">Sent</span>
      <h1 class="display display-sm">Thanks. <span class="hlw">Got it.</span></h1>
      <p class="lede">Your message reached us. We reply by email, usually within 1 business day.</p>
      <div class="actions"><a class="btn btn-secondary" href="/">Back to the home page <span class="k" aria-hidden="true">→</span></a></div>
    </div>
  </section>
</Base>
