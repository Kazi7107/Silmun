---
import Logo from './Logo.astro';
import StoreButton from './StoreButton.astro';
import { ROUTES, type AgentKey } from '../data/site';

interface Props { storeAgent: AgentKey }
const { storeAgent } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? { 'aria-current': 'page' } : {});
---
<!-- Desktop -->
<header class="gnav">
  <div class="wrap">
    <Logo />
    <nav class="gnav-links" aria-label="Site">
      <div class="dd-anchor" data-dropdown>
        <button class="gnav-link" type="button" aria-expanded="false" aria-controls="modules-menu" data-dropdown-toggle>Modules <span class="caret" aria-hidden="true">▾</span></button>
        <div class="dropdown" id="modules-menu" hidden>
          <a class="dd-row live" href={ROUTES.catalog} {...current(ROUTES.catalog)}><span class="dd-mod">Module</span><span class="nm">ITSM</span><span class="tag tag-live"><span class="dot"></span>Live</span><span class="ds">Catalog Automation: plain-language request in, catalog item out.</span></a>
          <a class="dd-row live" href={ROUTES.secops} {...current(ROUTES.secops)}><span class="dd-mod">Module</span><span class="nm">Security Operations</span><span class="tag tag-live"><span class="dot"></span>Live</span><span class="ds">Vulnerability Remediation agent.</span></a>
          <a class="dd-later" href={ROUTES.sourceToPay} {...current(ROUTES.sourceToPay)}><span>Finance &amp; Supply Chain · Source to Pay</span><span class="tag tag-later"><span class="dot"></span>Next</span></a>
        </div>
      </div>
      <a class="gnav-link" href={ROUTES.about} {...current(ROUTES.about)}>About us</a>
      <a class="gnav-link" href={ROUTES.support} {...current(ROUTES.support)}>Support</a>
      <a class="gnav-link" href={ROUTES.contact}>Contact</a>
    </nav>
    <StoreButton agent={storeAgent} class="btn btn-primary btn-sm" />
  </div>
</header>

<!-- Mobile -->
<header class="m-head">
  <div class="wrap">
    <Logo />
    <button class="m-menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Menu</button>
  </div>
</header>
<div class="m-menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu" hidden data-menu>
  <div class="m-menu-top"><Logo /><button class="m-menu-btn" type="button" data-menu-close>Close <span class="mono" aria-hidden="true">×</span></button></div>
  <nav class="m-menu-body" aria-label="Site">
    <span class="m-menu-sec">Modules</span>
    <a class="m-prod live" href={ROUTES.catalog} {...current(ROUTES.catalog)}><span class="dd-mod">Module</span><span class="m-prod-row"><span class="nm">ITSM</span><span class="tag tag-live"><span class="dot"></span>Live</span></span><span class="small">Catalog Automation</span></a>
    <a class="m-prod live" href={ROUTES.secops} {...current(ROUTES.secops)}><span class="dd-mod">Module</span><span class="m-prod-row"><span class="nm">Security Operations</span><span class="tag tag-live"><span class="dot"></span>Live</span></span><span class="small">Vulnerability Remediation</span></a>
    <a class="m-prod later" href={ROUTES.sourceToPay} {...current(ROUTES.sourceToPay)}><span class="nm">Source to Pay · next</span><span class="small dim">Finance &amp; Supply Chain</span></a>
    <span class="m-menu-sec">Company</span>
    <a class="m-link" href={ROUTES.about} {...current(ROUTES.about)}>About us <span class="k" aria-hidden="true">→</span></a>
    <a class="m-link" href={ROUTES.support} {...current(ROUTES.support)}>Support <span class="k" aria-hidden="true">→</span></a>
    <a class="m-link" href={ROUTES.contact} data-menu-close>Contact <span class="k" aria-hidden="true">→</span></a>
  </nav>
  <div class="m-menu-cta"><StoreButton agent={storeAgent} /></div>
</div>
